# copy to .env.local for dev, set the real ones in your host (Vercel, Cloud Run...)
# nothing here is a real secret. never commit the real values

# signs the session cookie. 32+ chars. generate: openssl rand -base64 48
AUTH_SECRET=

# a role with no code set can't be reached at all (fail closed)
RECRUITER_ACCESS_CODE=change-me-recruiter
ADMIN_ACCESS_CODE=change-me-admin-code

# only shown to recruiter + admin through /api/contact
CONTACT_PHONE=+33 6 00 00 00 00
CONTACT_WHATSAPP=+32 400 00 00 00

# optional. json overrides for feature flags, e.g. a 20% canary for the smart AI:
# FEATURE_FLAGS={"smart-ai":{"enabled":true,"rolloutPercent":20}}
FEATURE_FLAGS=

# optional. turns on the Claude coach (unset = the rule engine answers)
ANTHROPIC_API_KEY=

# optional. HIRE clicks + recruiter logins get posted here
SLACK_WEBHOOK_URL=
WEBHOOK_URL=
WEBHOOK_SECRET=

# optional. accept bearer tokens from a Keycloak realm
OIDC_ISSUER=
OIDC_AUDIENCE=

# optional. opentelemetry traces
OTEL_EXPORTER_OTLP_ENDPOINT=
