# copy to .env.local for dev, set the real ones in your host (Vercel, Cloud Run...)
# nothing here is a real secret. never commit the real values

# signs the session cookie. 32+ chars. generate: openssl rand -base64 48
AUTH_SECRET=

# a role with no code set can't be reached at all (fail closed)
RECRUITER_ACCESS_CODE=change-me-recruiter
ADMIN_ACCESS_CODE=change-me-admin-code

# only shown to recruiter + admin through /api/contact
CONTACT_PHONE=+33 6 00 00 00 00
CONTACT_WHATSAPP=+32 400 00 00 00
